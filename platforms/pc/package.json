{
  "name": "Shell++",
  "version": "1.0.0",
  "main": "src/main/index.js",
  "author": "ooooops.chan <ooooops.chan@gmail.com>",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "package-win": "electron-packager . Shell++ --platform=win32 --arch=x64 --out=dist --overwrite --icon=src/assets/icons/icon.ico",
    "package-mac": "electron-packager . Shell++ --platform=darwin --arch=x64 --out=dist --overwrite --icon=src/assets/icons/icon.icns",
    "package-linux": "electron-packager . Shell++ --platform=linux --arch=x64 --out=dist --overwrite --icon=src/assets/icons/icon.png",
    "electron:generate-icons": "electron-icon-builder --input=src/assets/icons/icon.png --output=src/assets/ --flatten"
  },
  "description": "Shell++, an ai box.",
  "devDependencies": {
    "electron": "^35.0.1",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "@langchain/community": "^0.3.41",
    "@langchain/core": "^0.3.49",
    "@langchain/openai": "^0.5.7",
    "abort-controller": "^3.0.0",
    "custom-electron-titlebar": "^4.2.8",
    "docx": "^9.4.1",
    "electron-icon-builder": "^2.0.1",
    "electron-log": "^5.3.2",
    "event-target-shim": "^6.0.2",
    "faiss-node": "^0.5.1",
    "html-to-text": "^9.0.5",
    "humanize-ms": "^2.0.0",
    "langchain": "^0.3.24",
    "mammoth": "^1.9.0",
    "ms": "^2.1.3",
    "pdf-parse": "^1.1.1",
    "webdav": "^5.8.0",
    "whatwg-url": "^14.2.0"
  }
}
